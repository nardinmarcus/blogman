[Unit]
Description=blogman WeChat bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/blogman-wechat-bridge
EnvironmentFile=/etc/blogman-wechat-bridge/bridge.env
ExecStart=/usr/bin/node /opt/blogman-wechat-bridge/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
